import { ListView } from "std-widgets.slint";
import { Strings } from "resources/en-US.slint";
import { Theme } from "theme.slint";
import { ConflictDialog, DeleteConfirmation, PatternSelection, ChecksumSheet, ChecksumRow } from "dialogs.slint";
import { ActivityCenter, ActivityRow } from "activity.slint";
import { Sidebar, SidebarEntry } from "sidebar.slint";
import { TabStrip, TabItem } from "tabs.slint";
import { DualPaneWorkspace } from "dual-pane.slint";
import { KindIcon } from "icons.slint";
import { WindowCaption } from "titlebar.slint";

// Represents a single file entry in the list.
struct FileRow {
    id: int,
    display-name: string,
    kind: string,      // "Folder" | "File" | "Symlink" | "Reparse Point"
    is-folder: bool,   // behaviour flag: drop targets branch on this, not on `kind`
    size-text: string,
    modified-text: string,
    type-text: string,
    attributes-text: string,
    selected: bool,
    icon-key: int,
    // Tranche 3 slice 4: the Shell's picture for this row, and whether there is one.
    // A row without a thumbnail renders exactly as it did before the slice.
    thumbnail: image,
    has-thumbnail: bool,
}

// Represents a column in the details header.
struct ColumnSpec {
    title: string,
    // Stable machine key ("name", "size", …): the header may be worded for humans, but a
    // row decides which value to show from this key, never from the label.
    key: string,
    width: length,
    visible: bool,
    sort-ascending: bool,
    sort-active: bool,
    sort-direction: string,  // "ascending" | "descending" | "none"
}

// ── FileListItem ──────────────────────────────────────────────────────────────

// A single row in the file list.
component FileListItem inherits Rectangle {
    in property <FileRow> entry;
    in property <bool> editing;
    in property <string> seed-text;
    in property <int> seed-selection;
    // The details columns, so a row puts each value under its own header.
    in property <[ColumnSpec]> columns: [];
    // The row height the list publishes; the OLE drop hit-test uses the same number.
    in property <length> item-height: 26px;
    property <string> editing-error: "";
    // The name cell is as wide as the header's first column; without columns (a bare
    // model in a test) it keeps a readable minimum.
    private property <length> name-width: root.columns.length > 0 ? root.columns[0].width : 200px;
    // Width the columns after the name occupy, published by the host from the column
    // layout. The name column takes what is left, so the table ends flush with the window
    // instead of stopping after the last column.


    // The text a row shows for a column, matched on the column's own title so a
    // translated locale keeps working: both sides read the same `Strings` global.
    public pure function cell-text(key: string) -> string {
        if (key == "size") { return root.entry.size-text; }
        if (key == "modified") { return root.entry.modified-text; }
        if (key == "type") { return root.entry.type-text; }
        if (key == "attributes") { return root.entry.attributes-text; }
        return "";
    }

    callback activated();
    callback selected(bool, bool);  // ctrl, shift
    callback context-menu(length, length);
    callback drag-started();
    callback rename-committed(string);
    callback rename-cancelled();
    callback rename-validate(string) -> string;

    height: root.item-height;
    background: self.entry.selected
        ? Theme.accent-soft
        : (touch.has-hover ? Theme.row-hover : Colors.transparent);

    animate background { duration: Theme.quick; }

    accessible-role: list-item;
    accessible-label: self.entry.display-name + ", " + self.entry.kind
        + (self.entry.selected ? ", selected" : "");
    accessible-action-default => { root.activated(); }

    // Tranche 3 slice 2: the drag gesture. The pointer crossing the threshold asks
    // the host to run an OLE drag (spec §7, decision 8); the Slint-internal transport
    // is retired, so OLE is the single transport in both directions.
    touch := TouchArea {
        // Where the press started, and whether the gesture already became a drag.
        property <length> press-x: 0px;
        property <length> press-y: 0px;
        property <bool> dragging: false;

        double-clicked => { root.activated(); }
        clicked => {
            // A drag that ended on the row does not change the selection.
            if (!touch.dragging) {
                root.selected(false, false);
            }
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.left
                    && event.kind == PointerEventKind.down) {
                touch.press-x = self.mouse-x;
                touch.press-y = self.mouse-y;
                touch.dragging = false;
            }
            if (event.button == PointerEventButton.right
                    && event.kind == PointerEventKind.up) {
                root.context-menu(self.mouse-x, self.mouse-y);
            }
        }
        moved => {
            if (!touch.dragging) {
                let dx = (self.mouse-x - touch.press-x) / 1px;
                let dy = (self.mouse-y - touch.press-y) / 1px;
                if (abs(dx) > 5 || abs(dy) > 5) {
                    touch.dragging = true;
                    root.drag-started();
                }
            }
        }
    }

    // One cell per column at the header's own widths, so a value sits under the column
    // that names it. The first cell also carries the thumbnail or the folder glyph.
    HorizontalLayout {
        spacing: 0px;

        // The name cell absorbs whatever width the other columns leave unused, so the
        // table ends flush with the window instead of stopping after the last column.
        // `name-cell.width` is the width the layout actually gave it, and the rename
        // editor below follows it.
        // The header row and every row take the widths the host publishes: the host gives
        // the name column whatever the window has left after the other columns, so the
        // table ends flush with the right edge (see `fit_columns` in the app crate).
        name-cell := Rectangle {
            width: root.name-width;
            clip: true;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 8px;
                spacing: 8px;

                // One fixed slot for the picture, the folder glyph or nothing: every name
                // starts at the same x, so a column of names reads as a column. A row that
                // skipped the slot would shift its own text left by its width.
                Rectangle {
                    width: root.item-height - 6px;
                    height: root.item-height - 6px;
                    background: transparent;

                    // The thumbnail asks for the Shell's picture; a miss leaves the glyph.
                    if root.entry.has-thumbnail: Image {
                        width: 100%;
                        height: 100%;
                        source: root.entry.thumbnail;
                        image-fit: contain;
                        // Decoration, not a control: the row's own accessible label already
                        // names the entry, and announcing the picture twice adds only noise.
                        accessible-role: none;
                    }
                    // Folders read differently from files at a glance, even without a
                    // per-type icon: one glyph, the same one the sidebar uses.
                    if !root.entry.has-thumbnail && root.entry.is-folder: KindIcon {
                        x: (parent.width - 16px) / 2;
                        y: (parent.height - 16px) / 2;
                        kind: 1;
                        tint: root.entry.selected ? Theme.accent-strong : Theme.text-faint;
                    }
                }
                Text {
                    text: root.entry.display-name;
                    color: root.entry.selected ? Theme.selected-text : Theme.text;
                    font-size: Theme.font-body;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        for col[i] in root.columns: Rectangle {
            width: i == 0 ? 0px : (col.visible ? col.width : 0px);
            clip: true;

            if i > 0 && col.visible: Text {
                x: 10px;
                width: parent.width - 18px;
                text: root.cell-text(col.key);
                color: root.entry.selected ? Theme.selected-text : Theme.text-muted;
                font-size: Theme.font-small;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    // Inline rename editor, anchored to this row so it follows the list scroll and never
    // sits on the wrong entry when the user scrolls while F2 is open.
    if self.editing: Rectangle {
        x: 2px;
        y: 1px;
        width: name-cell.width - 4px;
        height: parent.height - 2px;
        background: #ffffff;
        border-color: root.editing-error != "" ? #d13438 : #0078d7;
        border-width: 2px;

        init => {
            root.editing-error = "";
            rename-field.text = root.seed-text;
            rename-field.focus();
            rename-field.set-selection-offsets(0, root.seed-selection);
        }

        rename-field := TextInput {
            x: 2px;
            y: 1px;
            width: parent.width - 34px;
            height: parent.height - 2px;
            vertical-alignment: center;
            accessible-role: text-input;
            accessible-label: Strings.rename-input-label;
            edited => {
                root.editing-error = root.rename-validate(self.text);
            }
            accepted => {
                root.rename-committed(self.text);
            }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.rename-cancelled();
                    return accept;
                }
                reject
            }
        }

        rename-ok := TouchArea {
            x: parent.width - 30px;
            y: 1px;
            width: 28px;
            height: parent.height - 2px;
            accessible-role: button;
            accessible-label: Strings.rename-confirm-label;
            clicked => {
                root.rename-committed(rename-field.text);
            }
            Text {
                text: "✓";
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// ── FileList ──────────────────────────────────────────────────────────────────

// Virtualized list component.
component FileList inherits Rectangle {
    in property <[FileRow]> rows: [];
    in property <[ColumnSpec]> columns: [];
    in property <int> rename-target-id: -1;
    in property <string> rename-seed-text;
    in property <int> rename-seed-selection;
    callback row-activated(int);
    callback row-selected(int, bool, bool);
    callback context-menu-requested(int, length, length);
    callback drag-started(int);
    callback rename-committed(int, string);
    callback rename-cancelled(int);
    callback rename-validate(string) -> string;

    // Tranche 3 slice 2: the geometry the OLE drop hit-test needs. The UI publishes
    // it because the shell's drop callbacks run inside its own modal drag loop and
    // must not query the window there (spec §7).
    //   viewport-top:    top of the list, in logical pixels from the window origin
    //   viewport-height: height of the list viewport, in logical pixels
    //   scroll-offset:   how far the list is scrolled down, in logical pixels
    //   row-height:      height of one row, in logical pixels
    out property <length> viewport-top: self.absolute-position.y;
    out property <length> viewport-height: file-list.visible-height;
    out property <length> scroll-offset: -file-list.content-y;
    out property <length> row-height: 26px;
    callback geometry-changed();

    accessible-role: list;

    changed viewport-top => { root.geometry-changed(); }
    changed viewport-height => { root.geometry-changed(); }
    changed scroll-offset => { root.geometry-changed(); }

    file-list := ListView {
        for file-row[i] in rows: FileListItem {
            entry: file-row;
            columns: root.columns;
            item-height: root.row-height;
            editing: file-row.id == root.rename-target-id;
            seed-text: root.rename-seed-text;
            seed-selection: root.rename-seed-selection;
            activated => { root.row-activated(file-row.id); }
            selected(ctrl, shift) => { root.row-selected(file-row.id, ctrl, shift); }
            context-menu(x, y) => { root.context-menu-requested(file-row.id, x, y); }
            drag-started => { root.drag-started(file-row.id); }
            rename-committed(text) => { root.rename-committed(file-row.id, text); }
            rename-cancelled() => { root.rename-cancelled(file-row.id); }
            rename-validate(text) => {
                return root.rename-validate(text);
            }
        }
    }
}

// ── DetailsTable ──────────────────────────────────────────────────────────────

// Details table with sortable, resizable, and reorderable column headers.
// Rows are rendered by FileList; this component owns only the header row.
component DetailsTable inherits VerticalLayout {
    in property <[ColumnSpec]> columns: [];
    callback sort-by-column(int);
    // Emitted when the user drags a column resize handle. Arguments: (col-index, new-width).
    callback column-resize-requested(int, length);
    // Emitted when the user drags a column header to reorder it. Arguments: (from-index, to-index).
    callback column-reorder-requested(int, int);

    // Internal drag state for reordering
    private property <int> drag-source-index: -1;
    private property <bool> drag-active: false;

    // Column header row
    Rectangle {
        height: 30px;
        background: Theme.surface;

        Rectangle {
            y: parent.height - 1px;
            width: 100%;
            height: 1px;
            background: Theme.border;
        }

        HorizontalLayout {
            spacing: 0px;

            for col[i] in root.columns: Rectangle {
                width: col.width;
                clip: true;
                background: header-touch.has-hover ? Theme.row-hover : transparent;

                // Header cell touch area — clicking sorts, dragging reorders.
                header-touch := TouchArea {
                    width: parent.width - 6px;  // leave room for resize handle
                    height: 30px;
                    mouse-cursor: pointer;

                    clicked => { root.sort-by-column(i); }

                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left
                                && event.kind == PointerEventKind.down) {
                            root.drag-source-index = i;
                            root.drag-active = true;
                        }
                        if (event.button == PointerEventButton.left
                                && event.kind == PointerEventKind.up) {
                            if (root.drag-active && root.drag-source-index != i
                                    && root.drag-source-index >= 0) {
                                root.column-reorder-requested(root.drag-source-index, i);
                            }
                            root.drag-active = false;
                            root.drag-source-index = -1;
                        }
                    }

                    accessible-role: button;
                    accessible-label: col.sort-active
                        ? (col.title + (col.sort-ascending ? ", sorted ascending" : ", sorted descending"))
                        : col.title;
                }

                // Sort indicator + title text
                Text {
                    x: 10px;
                    y: 0px;
                    width: parent.width - 18px;
                    height: 30px;
                    text: col.sort-active
                        ? (col.title + (col.sort-ascending ? " ▲" : " ▼"))
                        : col.title;
                    color: col.sort-active ? Theme.accent-strong : Theme.text-muted;
                    font-size: Theme.font-small;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                    overflow: elide;
                }

                // Resize drag handle — thin touch area on the right edge.
                resize-handle := TouchArea {
                    x: parent.width - 6px;
                    y: 0px;
                    width: 6px;
                    height: 30px;
                    mouse-cursor: col-resize;

                    // Track drag start position
                    private property <length> drag-start-x: 0px;
                    private property <length> col-start-width: 0px;

                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left
                                && event.kind == PointerEventKind.down) {
                            self.drag-start-x = self.mouse-x;
                            self.col-start-width = col.width;
                        }
                        if (event.button == PointerEventButton.left
                                && event.kind == PointerEventKind.move) {
                            // new-width = clamp(col-start-width + delta, 40px, 600px)
                            // We emit the event; the Rust side does clamping.
                            root.column-resize-requested(
                                i,
                                self.col-start-width + (self.mouse-x - self.drag-start-x)
                            );
                        }
                    }

                    accessible-role: none;

                    // Visual divider line
                    Rectangle {
                        x: 2px;
                        y: 6px;
                        width: 1px;
                        height: 18px;
                        background: resize-handle.has-hover
                            ? Theme.accent
                            : Theme.border-strong;
                    }
                }
            }
        }
    }
}

// ── AddressBar ────────────────────────────────────────────────────────────────

// Editable address bar with autocomplete dropdown.
component AddressBar inherits Rectangle {
    in property <string> current-path: "";
    in property <[string]> completions: [];
    out property <bool> input-has-focus: addr-input.has-focus;
    callback confirmed(string);

    // Let the parent focus the inner TextInput.
    public function focus-input() {
        addr-input.focus();
    }

    height: 40px;
    background: Theme.chrome;
    border-width: 0px;

    // A rounded, inset field: the chrome band carries the padding, the field carries
    // the focus ring, so the address bar reads as one control and not as a boxed row.
    Rectangle {
        x: 10px;
        y: 6px;
        width: parent.width - 20px;
        height: parent.height - 12px;
        background: Theme.surface;
        border-width: 1px;
        border-color: addr-input.has-focus ? Theme.accent : Theme.border;
        border-radius: Theme.radius-sm;
        drop-shadow-color: #1c21280f;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;

        addr-input := TextInput {
            x: 10px;
            y: 0px;
            width: parent.width - 20px;
            height: parent.height;
            color: Theme.text;
            font-size: Theme.font-body;
            vertical-alignment: center;
            text: root.current-path;
            accessible-role: text-input;
            accessible-label: Strings.address-bar-label;
            accepted => { root.confirmed(self.text); }
        }
    }

    // Autocomplete dropdown — shown when there are completions.
    if root.completions.length > 0: Rectangle {
        y: root.height;
        x: 0px;
        width: root.width;
        height: min(root.completions.length * 24px, 144px);
        background: Theme.surface;
        border-color: Theme.border;
        border-width: 1px;
        border-radius: Theme.radius-sm;
        drop-shadow-color: #1c212824;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 2px;
        clip: true;

        accessible-role: list;
        accessible-label: Strings.autocomplete-placeholder;

        ListView {
            for item[_i] in root.completions: Rectangle {
                height: 24px;
                background: hovered.has-hover ? Theme.hover : transparent;
                accessible-role: list-item;
                accessible-label: item;
                accessible-action-default => { root.confirmed(item); }

                Text {
                    text: item;
                    x: 10px;
                    width: parent.width - 16px;
                    color: hovered.has-hover ? Theme.text : Theme.text-muted;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                    overflow: elide;
                }

                hovered := TouchArea {
                    clicked => { root.confirmed(item); }
                    mouse-cursor: pointer;
                }
            }
        }
    }
}

// ── SubfolderMenu ─────────────────────────────────────────────────────────────

// Popup subfolder list attached to a breadcrumb segment.
component SubfolderMenu inherits Rectangle {
    in property <[string]> subfolder-items: [];
    in property <bool> visible-menu: false;
    callback item-selected(string);
    callback close-requested();

    visible: self.visible-menu;
    background: Theme.surface;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: Theme.radius-sm;
    drop-shadow-color: #1c212826;
    drop-shadow-blur: 10px;
    drop-shadow-offset-y: 3px;
    width: 240px;
    height: min(self.subfolder-items.length * 26px + 8px, 220px);
    clip: true;

    accessible-role: list;
    accessible-label: Strings.subfolder-menu-label;

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            reject
        }

        ListView {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;

            for label[_i] in root.subfolder-items: Rectangle {
                height: 26px;
                background: item-touch.has-hover ? Theme.hover : transparent;
                accessible-role: list-item;
                accessible-label: label;
                accessible-action-default => { root.item-selected(label); }

                Text {
                    text: label;
                    x: 10px;
                    width: parent.width - 16px;
                    color: Theme.text;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                    overflow: elide;
                }

                item-touch := TouchArea {
                    clicked => { root.item-selected(label); }
                    mouse-cursor: pointer;
                }
            }
        }
    }
}

// ── Breadcrumb ────────────────────────────────────────────────────────────────

// Clickable breadcrumb with per-segment subfolder menus.
// Uses in-out for subfolder-menu-visible so the arrow click can toggle it locally.
component Breadcrumb inherits Rectangle {
    in property <[string]> segments: [];
    in property <[string]> subfolder-items: [];
    in-out property <bool> subfolder-menu-visible: false;
    in-out property <int> active-segment-index: -1;

    callback segment-clicked(int);
    callback subfolder-item-selected(string);

    height: 34px;
    background: Theme.chrome;
    accessible-role: none;
    accessible-label: Strings.breadcrumb-label;

    HorizontalLayout {
        alignment: start;
        spacing: 0px;
        padding-left: 4px;
        padding-right: 4px;

        for seg[i] in root.segments: HorizontalLayout {
            spacing: 0px;

            // Segment touch area
            seg-touch := TouchArea {
                width: seg-label.preferred-width + 16px;
                height: 34px;
                clicked => { root.segment-clicked(i); }
                accessible-role: button;
                accessible-label: seg;
                mouse-cursor: pointer;

                seg-label := Text {
                    x: 8px;
                    text: seg;
                    vertical-alignment: center;
                    color: seg-touch.has-hover ? Theme.accent-strong : Theme.text;
                    font-size: Theme.font-small;
                    overflow: elide;
                }
            }

            // Arrow button to open subfolder menu for this segment.
            arrow-touch := TouchArea {
                width: 16px;
                height: 34px;
                clicked => {
                    root.active-segment-index = i;
                    root.subfolder-menu-visible = true;
                }
                accessible-role: button;
                accessible-label: Strings.subfolder-menu-label;
                mouse-cursor: pointer;

                // U+25BC rather than U+25BE: Segoe UI carries the former, and the latter
                // was measured rendering as a missing-glyph box at this size.
                // Faint until pointed at: every segment carrying a permanent arrow made
                // the path read as a row of buttons rather than a location.
                Text {
                    text: "▼";
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    color: arrow-touch.has-hover ? Theme.accent-strong : Theme.text-faint;
                    opacity: arrow-touch.has-hover ? 1.0 : 0.35;
                    font-size: 8px;
                }
            }

            // Chevron separator — not shown after the last segment.
            if i < root.segments.length - 1: Text {
                text: "›";
                width: 14px;
                vertical-alignment: center;
                horizontal-alignment: center;
                color: Theme.text-faint;
                font-size: 13px;
            }
        }
    }

    // Subfolder popup — rendered as overlay when a segment's arrow was clicked.
    if root.subfolder-menu-visible && root.active-segment-index >= 0: SubfolderMenu {
        x: 4px;
        y: 34px;
        subfolder-items: root.subfolder-items;
        visible-menu: root.subfolder-menu-visible;
        item-selected(label) => {
            root.subfolder-menu-visible = false;
            root.subfolder-item-selected(label);
        }
        close-requested => {
            root.subfolder-menu-visible = false;
        }
    }
}

// ── ApplicationWindow ─────────────────────────────────────────────────────────

export component ApplicationWindow inherits Window {
    title: Strings.app-title;
    // The app draws its own caption bar; `fx-shell`'s window chrome keeps the frame's
    // resizing edges, dragging, double-click-to-maximise and the drop shadow.
    no-frame: true;
    background: Theme.chrome;
    min-width: 400px;
    min-height: 300px;

    // Mirrors the OS state so the caption button shows "maximise" or "restore".
    in-out property <bool> window-maximized: false;
    callback window-minimize();
    callback window-toggle-maximize();
    callback window-close();

    // ── Properties ──────────────────────────────────────────────────────────
    in property <[FileRow]> rows: [];
    in property <[ColumnSpec]> columns: [];
    in property <string> current-path: "";
    in property <string> filter-text: "";
    in property <string> status-message: "";
    in property <int> selected-count: 0;

    // Navigation
    in property <[string]> address-completions: [];
    in property <[string]> breadcrumb-segments: [];
    in property <[string]> subfolder-items: [];
    in-out property <bool> subfolder-menu-visible: false;

    // Tranche 4: Sidebar and drives.
    in property <[SidebarEntry]> sidebar-entries: [];

    // Tranche 5: tabs and dual pane.
    in property <[TabItem]> tab-items: [];
    in property <bool> dual-pane-enabled: false;
    in property <length> dual-pane-ratio: 50px;

    // Tranche 2: enriched status bar properties
    in property <string> status-item-count: "";
    in property <string> status-selected-count: "";
    in property <string> status-selected-bytes: "";
    in property <string> status-free-space: "";

    // Tranche 2: inline rename overlay
    // -1 means no rename is in progress.
    in property <int> status-rename-target-id: -1;
    in property <string> rename-seed-text;
    in property <int> rename-seed-selection: 0;
    callback rename-committed(int, string);
    callback rename-cancelled(int);
    callback rename-validate(string) -> string;

    // Tranche 2: activity center rows
    in property <[ActivityRow]> activity-rows: [];

    // Tranche 2: permanent-delete confirmation gate (Shift+Del)
    in-out property <bool> confirm-permanent-delete: false;
    in property <string> permanent-delete-count-text: "";

    // Tranche 2: conflict resolution dialog (OPS-09)
    in-out property <bool> show-conflict-dialog: false;
    in property <string> conflict-file-name: "";
    in property <string> conflict-source-path: "";
    in property <string> conflict-source-size: "";
    in property <string> conflict-source-modified: "";
    in property <string> conflict-destination-path: "";
    in property <string> conflict-destination-size: "";
    in property <string> conflict-destination-modified: "";

    // Tranche 2: checksum results panel (OPS-12, non-modal)
    in-out property <bool> show-checksum-sheet: false;
    in property <[ChecksumRow]> checksum-rows: [];

    // Tranche 2: pattern selection (OPS-11) and cleaner confirmation (OPS-13)
    in-out property <bool> show-pattern-dialog: false;
    in-out property <bool> confirm-empty-clean: false;
    in property <string> empty-clean-count-text: "";

    // Tranche 3 slice 2: OLE drag-and-drop (OPS-07). The row drag asks the host to
    // run a `DoDragDrop` source (spec §7); the list publishes the geometry the OLE
    // drop hit-test needs, because the shell's callbacks run inside its own modal
    // drag loop and cannot ask the window there.
    callback row-drag-started(int);
    // (viewport-top, viewport-height, row-height, scroll-offset), all in logical pixels.
    callback list-geometry-changed(length, length, length, length);
    callback pattern-submitted(string);
    callback pattern-cancelled();
    callback empty-clean-answered(bool);

    // ── Callbacks ────────────────────────────────────────────────────────────
    callback navigate-to(string);
    callback row-activated(int);
    callback row-selected(int, bool, bool);
    callback sort-by-column(int);
    callback filter-changed(string);
    callback address-bar-confirmed(string);
    callback breadcrumb-segment-clicked(int);
    callback subfolder-item-selected(string);
    callback sidebar-entry-selected(string);
    callback tab-selected(int);
    callback tab-close(int);
    callback tab-new();
    callback dual-pane-pane-activated(int);
    callback context-menu-requested(int, length, length);
    // History navigation
    callback navigate-back();
    callback navigate-forward();
    callback navigate-up();
    callback navigate-refresh();
    // Focus address bar (called from keyboard handler below or from orchestration)
    callback focus-address-bar();
    // Column resize/reorder
    callback column-resize-requested(int, length);
    callback column-reorder-requested(int, int);
    // Activity center
    callback activity-pause-op(int);
    callback activity-resume-op(int);
    callback activity-cancel-op(int);
    callback activity-retry-op(int);
    // Tranche 2: keyboard dispatch — (text, ctrl, shift, alt); true when the host handled it.
    callback shortcut-key(string, bool, bool, bool) -> bool;
    // Tranche 2: permanent-delete confirmation result
    callback permanent-delete-confirmed();
    callback permanent-delete-cancelled();
    // Tranche 2: conflict dialog result — (choice id, apply-to-all-in-class)
    callback conflict-resolved(string, bool);

    // ── Global keyboard handler ──────────────────────────────────────────────
    main-scope := FocusScope {
        // Keyboard-only path: shortcuts work from launch, before any click.
        init => { main-scope.focus(); }
        key-pressed(event) => {
            if (event.modifiers.alt && event.text == Key.LeftArrow) {
                root.navigate-back();
                return accept;
            }
            if (event.modifiers.alt && event.text == Key.RightArrow) {
                root.navigate-forward();
                return accept;
            }
            if (event.modifiers.alt && event.text == Key.UpArrow) {
                root.navigate-up();
                return accept;
            }
            // F5 key — Slint maps it to "\u{F708}" in event.text (F705 is F2).
            if (event.text == "\u{F708}") {
                root.navigate-refresh();
                return accept;
            }
            if (event.modifiers.control && event.text == "l") {
                addr-bar.focus-input();
                root.focus-address-bar();
                return accept;
            }
            if (event.modifiers.alt && event.text == "d") {
                addr-bar.focus-input();
                root.focus-address-bar();
                return accept;
            }
            // Tranche 2: forward file-operation shortcuts to the host dispatcher.
            // Never hijack text editing (address bar, inline rename) or a pending dialog.
            if (root.status-rename-target-id == -1 && !root.confirm-permanent-delete
                    && !root.show-conflict-dialog && !root.show-pattern-dialog
                    && !root.confirm-empty-clean && !addr-bar.input-has-focus) {
                if (root.shortcut-key(event.text, event.modifiers.control,
                        event.modifiers.shift, event.modifiers.alt)) {
                    return accept;
                }
            }
            reject
        }

        VerticalLayout {
            spacing: 0px;

            WindowCaption {
                title: Strings.app-name;
                maximized: root.window-maximized;
                minimize => { root.window-minimize(); }
                toggle-maximize => { root.window-toggle-maximize(); }
                close => { root.window-close(); }
            }

            tabs-bar := TabStrip {
                tabs: root.tab-items;
                tab-selected(id) => { root.tab-selected(id); }
                tab-close(id) => { root.tab-close(id); }
                tab-new() => { root.tab-new(); }
            }

            // Address bar with autocomplete
            addr-bar := AddressBar {
                current-path: root.current-path;
                completions: root.address-completions;
                confirmed(text) => { root.address-bar-confirmed(text); }
            }


            // Breadcrumb
            bc := Breadcrumb {
                segments: root.breadcrumb-segments;
                subfolder-items: root.subfolder-items;
                subfolder-menu-visible <=> root.subfolder-menu-visible;
                segment-clicked(i) => { root.breadcrumb-segment-clicked(i); }
                subfolder-item-selected(label) => { root.subfolder-item-selected(label); }
            }

            main-row := HorizontalLayout {
                vertical-stretch: 1;

                side-band := Sidebar {
                    entries: root.sidebar-entries;
                    entry-selected(id) => { root.sidebar-entry-selected(id); }
                }

                // The table column takes the width the sidebar leaves. Without the
                // horizontal stretch a layout child keeps its *preferred* width, so the
                // table (and the Type column) stopped well short of the window's right
                // edge, and a maximised window never widened it.
                VerticalLayout {
                    vertical-stretch: 1;
                    horizontal-stretch: 1;

                    // Mounted only when the workspace asks for it: an invisible element
                    // still occupies layout space in Slint, which silently pushed the
                    // details list down by the pane frame's height while it was hidden.
                    if root.dual-pane-enabled: DualPaneWorkspace {
                        enabled: true;
                        split-ratio: root.dual-pane-ratio;
                        pane-activated(index) => { root.dual-pane-pane-activated(index); }
                    }

                    // Column headers
                    DetailsTable {
                        columns: root.columns;
                        sort-by-column(i) => { root.sort-by-column(i); }
                        column-resize-requested(col-index, new-width) => {
                            root.column-resize-requested(col-index, new-width);
                        }
                        column-reorder-requested(from-index, to-index) => {
                            root.column-reorder-requested(from-index, to-index);
                        }
                    }

                    // Virtualized file list
                    file-list-area := Rectangle {
                        vertical-stretch: 1;

                        FileList {
                            width: 100%;
                            height: 100%;
                            rows: root.rows;
                            columns: root.columns;
                            row-activated(id) => { root.row-activated(id); }
                            row-selected(id, ctrl, shift) => {
                                // The row's TouchArea absorbs the press; take keyboard focus
                                // explicitly so file shortcuts work after clicking a row.
                                main-scope.focus();
                                root.row-selected(id, ctrl, shift);
                            }
                            context-menu-requested(id, x, y) => { root.context-menu-requested(id, x, y); }
                            drag-started(id) => { root.row-drag-started(id); }
                            geometry-changed => {
                                root.list-geometry-changed(self.viewport-top, self.viewport-height,
                                    self.row-height, self.scroll-offset);
                            }
                            rename-target-id: root.status-rename-target-id;
                            rename-seed-text: root.rename-seed-text;
                            rename-seed-selection: root.rename-seed-selection;
                            rename-committed(id, text) => {
                                root.rename-committed(id, text);
                                main-scope.focus();
                            }
                            rename-cancelled(id) => {
                                root.rename-cancelled(id);
                                main-scope.focus();
                            }
                            rename-validate(text) => {
                                return root.rename-validate(text);
                            }
                        }
                    }
                }
            }

            // Activity center
            ActivityCenter {
                rows: root.activity-rows;
                pause-op(i) => { root.activity-pause-op(i); }
                resume-op(i) => { root.activity-resume-op(i); }
                cancel-op(i) => { root.activity-cancel-op(i); }
                retry-op(i) => { root.activity-retry-op(i); }
            }

            // Enriched status bar
            Rectangle {
                height: 28px;
                background: Theme.chrome;
                accessible-role: none;
                accessible-label: root.status-message;

                Rectangle {
                    y: 0px;
                    width: 100%;
                    height: 1px;
                    background: Theme.border;
                }

                HorizontalLayout {
                    spacing: 14px;
                    padding-left: 12px;
                    padding-right: 12px;

                    Text {
                        text: root.status-message;
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                        horizontal-stretch: 2;
                    }

                    Text {
                        text: root.status-item-count;
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    if root.status-selected-count != "": Text {
                        text: root.status-selected-count;
                        color: Theme.selected-text;
                        font-size: Theme.font-small;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }

                    if root.status-selected-bytes != "": Text {
                        text: root.status-selected-bytes;
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }

                    if root.status-free-space != "": Text {
                        text: root.status-free-space;
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                }
            }
        }

        // Permanent-delete confirmation (Shift+Del): explicit gate before anything is
        // destroyed (PRD 14.2). The backdrop absorbs clicks; Escape cancels.
        if root.confirm-permanent-delete: Rectangle {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            background: #00000066;
            TouchArea {}

            confirm-scope := FocusScope {
                x: (parent.width - 420px) / 2;
                y: (parent.height - 200px) / 2;
                width: 420px;
                height: 200px;
                init => { confirm-scope.focus(); }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.confirm-permanent-delete = false;
                        root.permanent-delete-cancelled();
                        return accept;
                    }
                    reject
                }

                DeleteConfirmation {
                    width: 100%;
                    height: 100%;
                    item-count-text: root.permanent-delete-count-text;
                    confirmed => {
                        root.confirm-permanent-delete = false;
                        root.permanent-delete-confirmed();
                    }
                    cancelled => {
                        root.confirm-permanent-delete = false;
                        root.permanent-delete-cancelled();
                    }
                }
            }
        }

        // Conflict resolution (OPS-09): modal overlay; the worker stays paused until
        // an answer. Escape closes and answers cancel, like any abandoned dialog.
        if root.show-conflict-dialog: Rectangle {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            background: #00000066;
            TouchArea {}

            conflict-scope := FocusScope {
                x: (parent.width - 460px) / 2;
                y: (parent.height - 320px) / 2;
                width: 460px;
                height: 320px;
                init => { conflict-scope.focus(); }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.show-conflict-dialog = false;
                        root.conflict-resolved("cancel", false);
                        return accept;
                    }
                    reject
                }

                conflict-dialog := ConflictDialog {
                    width: 100%;
                    height: 100%;
                    file-name: root.conflict-file-name;
                    source-path: root.conflict-source-path;
                    source-size: root.conflict-source-size;
                    source-modified: root.conflict-source-modified;
                    destination-path: root.conflict-destination-path;
                    destination-size: root.conflict-destination-size;
                    destination-modified: root.conflict-destination-modified;
                    replace => {
                        root.show-conflict-dialog = false;
                        root.conflict-resolved("replace", conflict-dialog.apply-to-all);
                    }
                    skip => {
                        root.show-conflict-dialog = false;
                        root.conflict-resolved("skip", conflict-dialog.apply-to-all);
                    }
                    keep-both => {
                        root.show-conflict-dialog = false;
                        root.conflict-resolved("keep-both", conflict-dialog.apply-to-all);
                    }
                    cancel => {
                        root.show-conflict-dialog = false;
                        root.conflict-resolved("cancel", false);
                    }
                }
            }
        }

        // Tranche 2: select-by-pattern (OPS-11).
        if root.show-pattern-dialog: Rectangle {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            background: #00000066;
            TouchArea {}

            pattern-scope := FocusScope {
                x: (parent.width - 360px) / 2;
                y: (parent.height - 180px) / 2;
                width: 360px;
                height: 180px;
                init => { pattern-scope.focus(); }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.show-pattern-dialog = false;
                        root.pattern-cancelled();
                        return accept;
                    }
                    reject
                }

                PatternSelection {
                    width: 100%;
                    height: 100%;
                    selected(pattern) => {
                        root.show-pattern-dialog = false;
                        root.pattern-submitted(pattern);
                    }
                    cancelled => {
                        root.show-pattern-dialog = false;
                        root.pattern-cancelled();
                    }
                }
            }
        }

        // Tranche 2: empty-folder cleaner confirmation (OPS-13, report-first).
        if root.confirm-empty-clean: Rectangle {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            background: #00000066;
            TouchArea {}

            clean-scope := FocusScope {
                x: (parent.width - 420px) / 2;
                y: (parent.height - 200px) / 2;
                width: 420px;
                height: 200px;
                init => { clean-scope.focus(); }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.confirm-empty-clean = false;
                        root.empty-clean-answered(false);
                        return accept;
                    }
                    reject
                }

                DeleteConfirmation {
                    width: 100%;
                    height: 100%;
                    item-count-text: root.empty-clean-count-text;
                    confirmed => {
                        root.confirm-empty-clean = false;
                        root.empty-clean-answered(true);
                    }
                    cancelled => {
                        root.confirm-empty-clean = false;
                        root.empty-clean-answered(false);
                    }
                }
            }
        }

        // Tranche 2: checksum results (OPS-12 "menu and panel"). Deliberately
        // non-modal: browsing continues while digests are on screen.
        if root.show-checksum-sheet: Rectangle {
            x: (parent.width - 640px) / 2;
            y: (parent.height - 340px) / 2;
            width: 640px;
            height: 340px;
            border-color: #cccccc;
            border-width: 1px;

            checksum-scope := FocusScope {
                width: 100%;
                height: 100%;
                init => { checksum-scope.focus(); }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.show-checksum-sheet = false;
                        return accept;
                    }
                    reject
                }

                ChecksumSheet {
                    width: 100%;
                    height: 100%;
                    rows: root.checksum-rows;
                    closed => { root.show-checksum-sheet = false; }
                }
            }
        }
    }
}

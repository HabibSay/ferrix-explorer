import { ListView } from "std-widgets.slint";
import { Strings } from "resources/en-US.slint";

// Represents a single file entry in the list.
struct FileRow {
    id: int,
    display-name: string,
    kind: string,      // "Folder" | "File" | "Symlink" | "Reparse Point"
    size-text: string,
    modified-text: string,
    type-text: string,
    attributes-text: string,
    selected: bool,
    icon-key: int,
}

// Represents a column in the details header.
struct ColumnSpec {
    title: string,
    width: length,
    visible: bool,
    sort-ascending: bool,
    sort-active: bool,
    sort-direction: string,  // "ascending" | "descending" | "none"
}

// ── FileListItem ──────────────────────────────────────────────────────────────

// A single row in the file list.
component FileListItem inherits Rectangle {
    in property <FileRow> entry;
    callback activated();
    callback selected(bool, bool);  // ctrl, shift
    callback context-menu(length, length);

    height: 22px;
    background: self.entry.selected ? #0078d7 : Colors.transparent;

    accessible-role: list-item;
    accessible-label: self.entry.display-name + ", " + self.entry.kind
        + (self.entry.selected ? ", selected" : "");
    accessible-action-default => { root.activated(); }

    touch := TouchArea {
        double-clicked => { root.activated(); }
        clicked => { root.selected(false, false); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right
                    && event.kind == PointerEventKind.up) {
                root.context-menu(self.mouse-x, self.mouse-y);
            }
        }
    }

    HorizontalLayout {
        spacing: 0px;
        padding-left: 4px;
        Text {
            text: root.entry.display-name;
            color: root.entry.selected ? #ffffff : #000000;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// ── FileList ──────────────────────────────────────────────────────────────────

// Virtualized list component.
component FileList inherits Rectangle {
    in property <[FileRow]> rows: [];
    callback row-activated(int);
    callback row-selected(int, bool, bool);
    callback context-menu-requested(int, length, length);

    accessible-role: list;

    ListView {
        for file-row[i] in rows: FileListItem {
            entry: file-row;
            activated => { root.row-activated(file-row.id); }
            selected(ctrl, shift) => { root.row-selected(file-row.id, ctrl, shift); }
            context-menu(x, y) => { root.context-menu-requested(file-row.id, x, y); }
        }
    }
}

// ── DetailsTable ──────────────────────────────────────────────────────────────

// Details table with sortable, resizable, and reorderable column headers.
// Rows are rendered by FileList; this component owns only the header row.
component DetailsTable inherits VerticalLayout {
    in property <[ColumnSpec]> columns: [];
    callback sort-by-column(int);
    // Emitted when the user drags a column resize handle. Arguments: (col-index, new-width).
    callback column-resize-requested(int, length);
    // Emitted when the user drags a column header to reorder it. Arguments: (from-index, to-index).
    callback column-reorder-requested(int, int);

    // Internal drag state for reordering
    private property <int> drag-source-index: -1;
    private property <bool> drag-active: false;

    // Column header row
    Rectangle {
        height: 28px;
        background: #f0f0f0;

        HorizontalLayout {
            spacing: 0px;

            for col[i] in root.columns: Rectangle {
                width: col.width;
                clip: true;

                // Header cell touch area — clicking sorts, dragging reorders.
                header-touch := TouchArea {
                    width: parent.width - 6px;  // leave room for resize handle
                    height: 28px;

                    clicked => { root.sort-by-column(i); }

                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left
                                && event.kind == PointerEventKind.down) {
                            root.drag-source-index = i;
                            root.drag-active = true;
                        }
                        if (event.button == PointerEventButton.left
                                && event.kind == PointerEventKind.up) {
                            if (root.drag-active && root.drag-source-index != i
                                    && root.drag-source-index >= 0) {
                                root.column-reorder-requested(root.drag-source-index, i);
                            }
                            root.drag-active = false;
                            root.drag-source-index = -1;
                        }
                    }

                    accessible-role: button;
                    accessible-label: col.sort-active
                        ? (col.title + (col.sort-ascending ? ", sorted ascending" : ", sorted descending"))
                        : col.title;
                }

                // Sort indicator + title text
                Text {
                    x: 4px;
                    y: 0px;
                    width: parent.width - 10px;
                    height: 28px;
                    text: col.sort-active
                        ? (col.title + (col.sort-ascending ? " ▲" : " ▼"))
                        : col.title;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                    overflow: elide;
                }

                // Resize drag handle — thin touch area on the right edge.
                resize-handle := TouchArea {
                    x: parent.width - 6px;
                    y: 0px;
                    width: 6px;
                    height: 28px;
                    mouse-cursor: col-resize;

                    // Track drag start position
                    private property <length> drag-start-x: 0px;
                    private property <length> col-start-width: 0px;

                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left
                                && event.kind == PointerEventKind.down) {
                            self.drag-start-x = self.mouse-x;
                            self.col-start-width = col.width;
                        }
                        if (event.button == PointerEventButton.left
                                && event.kind == PointerEventKind.move) {
                            // new-width = clamp(col-start-width + delta, 40px, 600px)
                            // We emit the event; the Rust side does clamping.
                            root.column-resize-requested(
                                i,
                                self.col-start-width + (self.mouse-x - self.drag-start-x)
                            );
                        }
                    }

                    accessible-role: none;

                    // Visual divider line
                    Rectangle {
                        x: 2px;
                        y: 4px;
                        width: 1px;
                        height: 20px;
                        background: #cccccc;
                    }
                }
            }
        }
    }
}

// ── AddressBar ────────────────────────────────────────────────────────────────

// Editable address bar with autocomplete dropdown.
component AddressBar inherits Rectangle {
    in property <string> current-path: "";
    in property <[string]> completions: [];
    callback confirmed(string);

    // Let the parent focus the inner TextInput.
    public function focus-input() {
        addr-input.focus();
    }

    height: 30px;
    background: white;
    border-color: #cccccc;
    border-width: 1px;

    addr-input := TextInput {
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
        text: root.current-path;
        accessible-role: text-input;
        accessible-label: Strings.address-bar-label;
        accepted => { root.confirmed(self.text); }
    }

    // Autocomplete dropdown — shown when there are completions.
    if root.completions.length > 0: Rectangle {
        y: root.height;
        x: 0px;
        width: root.width;
        height: min(root.completions.length * 22px, 132px);
        background: #ffffff;
        border-color: #aaaaaa;
        border-width: 1px;

        accessible-role: list;
        accessible-label: Strings.autocomplete-placeholder;

        ListView {
            for item[_i] in root.completions: TouchArea {
                height: 22px;
                clicked => { root.confirmed(item); }
                accessible-role: list-item;
                accessible-label: item;
                Text {
                    text: item;
                    x: 4px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}

// ── SubfolderMenu ─────────────────────────────────────────────────────────────

// Popup subfolder list attached to a breadcrumb segment.
component SubfolderMenu inherits Rectangle {
    in property <[string]> subfolder-items: [];
    in property <bool> visible-menu: false;
    callback item-selected(string);
    callback close-requested();

    visible: self.visible-menu;
    background: #ffffff;
    border-color: #aaaaaa;
    border-width: 1px;
    width: 220px;
    height: min(self.subfolder-items.length * 22px + 4px, 200px);

    accessible-role: list;
    accessible-label: Strings.subfolder-menu-label;

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            reject
        }

        ListView {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;

            for label[_i] in root.subfolder-items: TouchArea {
                height: 22px;
                clicked => { root.item-selected(label); }
                accessible-role: list-item;
                accessible-label: label;
                Text {
                    text: label;
                    x: 4px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}

// ── Breadcrumb ────────────────────────────────────────────────────────────────

// Clickable breadcrumb with per-segment subfolder menus.
// Uses in-out for subfolder-menu-visible so the arrow click can toggle it locally.
component Breadcrumb inherits Rectangle {
    in property <[string]> segments: [];
    in property <[string]> subfolder-items: [];
    in-out property <bool> subfolder-menu-visible: false;
    in-out property <int> active-segment-index: -1;

    callback segment-clicked(int);
    callback subfolder-item-selected(string);

    height: 28px;
    background: #e8e8e8;
    accessible-role: none;
    accessible-label: Strings.breadcrumb-label;

    HorizontalLayout {
        alignment: start;
        spacing: 0px;
        padding-left: 4px;
        padding-right: 4px;

        for seg[i] in root.segments: HorizontalLayout {
            spacing: 0px;

            // Segment touch area
            seg-touch := TouchArea {
                width: seg-label.preferred-width + 8px;
                height: 28px;
                clicked => { root.segment-clicked(i); }
                accessible-role: button;
                accessible-label: seg;

                seg-label := Text {
                    x: 4px;
                    text: seg;
                    vertical-alignment: center;
                    color: #0060c0;
                    overflow: elide;
                }
            }

            // Arrow button to open subfolder menu for this segment.
            arrow-touch := TouchArea {
                width: 16px;
                height: 28px;
                clicked => {
                    root.active-segment-index = i;
                    root.subfolder-menu-visible = true;
                }
                accessible-role: button;
                accessible-label: Strings.subfolder-menu-label;

                Text {
                    text: "▾";
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    color: #666666;
                }
            }

            // Chevron separator — not shown after the last segment.
            if i < root.segments.length - 1: Text {
                text: " > ";
                vertical-alignment: center;
                color: #888888;
            }
        }
    }

    // Subfolder popup — rendered as overlay when a segment's arrow was clicked.
    if root.subfolder-menu-visible && root.active-segment-index >= 0: SubfolderMenu {
        x: 4px;
        y: 28px;
        subfolder-items: root.subfolder-items;
        visible-menu: root.subfolder-menu-visible;
        item-selected(label) => {
            root.subfolder-menu-visible = false;
            root.subfolder-item-selected(label);
        }
        close-requested => {
            root.subfolder-menu-visible = false;
        }
    }
}

// ── ApplicationWindow ─────────────────────────────────────────────────────────

export component ApplicationWindow inherits Window {
    title: Strings.app-title;
    min-width: 400px;
    min-height: 300px;

    // ── Properties ──────────────────────────────────────────────────────────
    in property <[FileRow]> rows: [];
    in property <[ColumnSpec]> columns: [];
    in property <string> current-path: "";
    in property <string> filter-text: "";
    in property <string> status-message: "";
    in property <int> selected-count: 0;

    // Navigation
    in property <[string]> address-completions: [];
    in property <[string]> breadcrumb-segments: [];
    in property <[string]> subfolder-items: [];
    in-out property <bool> subfolder-menu-visible: false;

    // ── Callbacks ────────────────────────────────────────────────────────────
    callback navigate-to(string);
    callback row-activated(int);
    callback row-selected(int, bool, bool);
    callback sort-by-column(int);
    callback filter-changed(string);
    callback address-bar-confirmed(string);
    callback breadcrumb-segment-clicked(int);
    callback subfolder-item-selected(string);
    callback context-menu-requested(int, length, length);
    // History navigation
    callback navigate-back();
    callback navigate-forward();
    callback navigate-up();
    callback navigate-refresh();
    // Focus address bar (called from keyboard handler below or from orchestration)
    callback focus-address-bar();
    // Column resize/reorder
    callback column-resize-requested(int, length);
    callback column-reorder-requested(int, int);

    // ── Global keyboard handler ──────────────────────────────────────────────
    FocusScope {
        key-pressed(event) => {
            if (event.modifiers.alt && event.text == Key.LeftArrow) {
                root.navigate-back();
                return accept;
            }
            if (event.modifiers.alt && event.text == Key.RightArrow) {
                root.navigate-forward();
                return accept;
            }
            if (event.modifiers.alt && event.text == Key.UpArrow) {
                root.navigate-up();
                return accept;
            }
            // F5 key — Slint maps it to "\u{F705}" in event.text.
            if (event.text == "\u{F705}") {
                root.navigate-refresh();
                return accept;
            }
            if (event.modifiers.control && event.text == "l") {
                addr-bar.focus-input();
                root.focus-address-bar();
                return accept;
            }
            if (event.modifiers.alt && event.text == "d") {
                addr-bar.focus-input();
                root.focus-address-bar();
                return accept;
            }
            reject
        }

        VerticalLayout {
            spacing: 0px;

            // Address bar with autocomplete
            addr-bar := AddressBar {
                current-path: root.current-path;
                completions: root.address-completions;
                confirmed(text) => { root.address-bar-confirmed(text); }
            }

            // Breadcrumb
            bc := Breadcrumb {
                segments: root.breadcrumb-segments;
                subfolder-items: root.subfolder-items;
                subfolder-menu-visible <=> root.subfolder-menu-visible;
                segment-clicked(i) => { root.breadcrumb-segment-clicked(i); }
                subfolder-item-selected(label) => { root.subfolder-item-selected(label); }
            }

            // Column headers
            DetailsTable {
                columns: root.columns;
                sort-by-column(i) => { root.sort-by-column(i); }
                column-resize-requested(col-index, new-width) => {
                    root.column-resize-requested(col-index, new-width);
                }
                column-reorder-requested(from-index, to-index) => {
                    root.column-reorder-requested(from-index, to-index);
                }
            }

            // Virtualized file list
            FileList {
                vertical-stretch: 1;
                rows: root.rows;
                row-activated(id) => { root.row-activated(id); }
                row-selected(id, ctrl, shift) => { root.row-selected(id, ctrl, shift); }
                context-menu-requested(id, x, y) => { root.context-menu-requested(id, x, y); }
            }

            // Status bar
            Rectangle {
                height: 22px;
                background: #f8f8f8;
                accessible-role: none;
                accessible-label: root.status-message;
                Text {
                    x: 4px;
                    text: root.status-message;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                }
            }
        }
    }
}

// Tranche 2 modal dialogs: conflict resolution, delete confirmation, pattern selection,
// and checksum display.
import { Button, CheckBox, ListView } from "std-widgets.slint";
import { Strings } from "resources/en-US.slint";

// ── ConflictDialog ────────────────────────────────────────────────────────────

// Modal conflict dialog shown when a paste/move operation encounters an existing item.
// Shows source and destination metadata for comparison, offers four resolution choices,
// and lets the user apply the decision to all similar conflicts.
export component ConflictDialog inherits Rectangle {
    // Name shown in the headline so the label says which file is at stake.
    in property <string> file-name: "";
    // Source item
    in property <string> source-path: "";
    in property <string> source-size: "";
    in property <string> source-modified: "";
    // Destination item
    in property <string> destination-path: "";
    in property <string> destination-size: "";
    in property <string> destination-modified: "";
    // Apply-to-all state
    in-out property <bool> apply-to-all: false;

    callback replace();
    callback skip();
    callback keep-both();
    callback cancel();

    min-width: 420px;
    min-height: 280px;
    background: #ffffff;
    border-color: #cccccc;
    border-width: 1px;

    VerticalLayout {
        spacing: 8px;
        padding: 16px;

        Text {
            text: Strings.conflict-question-before + root.file-name + Strings.conflict-question-after;
            wrap: word-wrap;
            accessible-role: text;
        }

        // Source metadata
        GridLayout {
            spacing: 4px;
            Row {
                Text { text: Strings.conflict-source-heading; font-weight: 700; }
                Text { text: root.source-path; overflow: elide; }
            }
            Row {
                Text { text: Strings.conflict-size-label; }
                Text { text: root.source-size; }
            }
            Row {
                Text { text: Strings.conflict-modified-label; }
                Text { text: root.source-modified; }
            }
        }

        // Destination metadata
        GridLayout {
            spacing: 4px;
            Row {
                Text { text: Strings.conflict-destination-heading; font-weight: 700; }
                Text { text: root.destination-path; overflow: elide; }
            }
            Row {
                Text { text: Strings.conflict-size-label; }
                Text { text: root.destination-size; }
            }
            Row {
                Text { text: Strings.conflict-modified-label; }
                Text { text: root.destination-modified; }
            }
        }

        // Apply-to-all checkbox
        HorizontalLayout {
            spacing: 6px;
            CheckBox {
                checked <=> root.apply-to-all;
                text: Strings.conflict-apply-to-all;
                accessible-label: Strings.conflict-apply-to-all;
            }
        }

        // Action buttons
        HorizontalLayout {
            spacing: 8px;
            alignment: end;

            Button {
                text: Strings.conflict-replace;
                accessible-label: Strings.conflict-replace-label;
                clicked => { root.replace(); }
            }
            Button {
                text: Strings.conflict-skip;
                accessible-label: Strings.conflict-skip-label;
                clicked => { root.skip(); }
            }
            Button {
                text: Strings.conflict-keep-both;
                accessible-label: Strings.conflict-keep-both-label;
                clicked => { root.keep-both(); }
            }
            Button {
                text: Strings.action-cancel;
                accessible-label: Strings.action-cancel-operation-label;
                clicked => { root.cancel(); }
            }
        }
    }
}

// ── DeleteConfirmation ────────────────────────────────────────────────────────

// Modal confirmation dialog for permanent deletion (Shift+Del).
export component DeleteConfirmation inherits Rectangle {
    // Set by the host together with the dialog flag; the component carries no text itself.
    in property <string> item-count-text;

    callback confirmed();
    callback cancelled();

    min-width: 360px;
    min-height: 160px;
    background: #ffffff;
    border-color: #cccccc;
    border-width: 1px;

    VerticalLayout {
        spacing: 8px;
        padding: 16px;

        Text {
            text: Strings.delete-question-before + root.item-count-text + Strings.delete-question-after;
            wrap: word-wrap;
            accessible-role: text;
        }

        Text {
            text: Strings.delete-warning;
            color: #cc0000;
            font-weight: 700;
            accessible-role: text;
            accessible-label: Strings.delete-warning-label;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: end;

            Button {
                text: Strings.delete-confirm;
                accessible-label: Strings.delete-confirm-label;
                clicked => { root.confirmed(); }
            }
            Button {
                text: Strings.action-cancel;
                accessible-label: Strings.delete-cancel-label;
                clicked => { root.cancelled(); }
            }
        }
    }
}

// ── PatternSelection ──────────────────────────────────────────────────────────

// Dialog for selecting entries by a glob pattern.
export component PatternSelection inherits Rectangle {
    in property <string> pattern: "";

    callback selected(string);
    callback cancelled();

    min-width: 320px;
    min-height: 120px;
    background: #ffffff;
    border-color: #cccccc;
    border-width: 1px;

    VerticalLayout {
        spacing: 8px;
        padding: 16px;

        Text { text: Strings.pattern-question; }

        pattern-input := TextInput {
            text: root.pattern;
            accessible-role: text-input;
            accessible-label: Strings.pattern-input-label;
            accepted => { root.selected(self.text); }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: end;

            Button {
                text: Strings.pattern-select;
                accessible-label: Strings.pattern-select-label;
                clicked => { root.selected(pattern-input.text); }
            }
            Button {
                text: Strings.action-cancel;
                accessible-label: Strings.pattern-cancel-label;
                clicked => { root.cancelled(); }
            }
        }
    }
}

// ── ChecksumSheet ─────────────────────────────────────────────────────────────

// Struct for one checksum row.
export struct ChecksumRow {
    path: string,
    md5: string,
    sha256: string,
    blake3: string,
}

// Non-modal sheet displaying computed checksums for the selected files.
export component ChecksumSheet inherits Rectangle {
    in property <[ChecksumRow]> rows: [];

    callback closed();

    min-width: 600px;
    min-height: 300px;
    background: #ffffff;
    border-color: #cccccc;
    border-width: 1px;

    VerticalLayout {
        spacing: 8px;
        padding: 12px;

        // Header row
        HorizontalLayout {
            spacing: 8px;
            Text { text: Strings.checksum-col-path; width: 200px; font-weight: 700; overflow: elide; }
            Text { text: Strings.checksum-col-md5; width: 120px; font-weight: 700; overflow: elide; }
            Text { text: Strings.checksum-col-sha256; width: 160px; font-weight: 700; overflow: elide; }
            Text { text: Strings.checksum-col-blake3; width: 160px; font-weight: 700; overflow: elide; }
        }

        // Data rows
        ListView {
            vertical-stretch: 1;
            accessible-role: list;
            for row in root.rows: HorizontalLayout {
                spacing: 8px;
                height: 22px;
                Text { text: row.path; width: 200px; overflow: elide; vertical-alignment: center; }
                Text { text: row.md5; width: 120px; overflow: elide; vertical-alignment: center; }
                Text { text: row.sha256; width: 160px; overflow: elide; vertical-alignment: center; }
                Text { text: row.blake3; width: 160px; overflow: elide; vertical-alignment: center; }
            }
        }

        HorizontalLayout {
            alignment: end;
            Button {
                text: Strings.checksum-close;
                accessible-label: Strings.checksum-close-label;
                clicked => { root.closed(); }
            }
        }
    }
}
